---
/**
 * 曲目表。
 *
 * 每行呈现：序号 / 曲名（下挂原曲与出处）/ 编曲或作曲 / 演唱 / 时长。
 * 原创曲与二创曲的署名不同（compose vs arrange），这里统一成「编曲・作曲」列，
 * 有哪个显示哪个 —— 这样一张混合曲目的专辑也能对齐。
 *
 * 行尾不挂试听按钮：一张专辑的试听入口在头部（见 [catalog].astro），
 * 每行再放一个圆钮是重复的出口，且会把曲名挤窄。
 *
 * 溢出文字的悬停滚动：曲名 / 原曲出处 / 编曲作曲 / 演唱这四列的文字比格子长时，
 * 默认右侧渐隐遮罩提示「还有更多」，悬停时自动横向滚动展示全文。
 * 机制（.clip / .clip-inner 与测量脚本）已抽成全站共用的
 * `src/styles/clip.css` + BaseLayout 里的那段脚本 —— 曲目库索引表用的是同一套，
 * 所以这个组件里既不再有那段脚本，也不再重复写遮罩与动画规则。
 * （这里原本写的是脚本标签的字面量 —— 那会绊倒 Vite 的依赖扫描，见 CopyScript.astro。）
 * 手机端（≤720px）这几列本来就不截断，内层随之退化为普通行内文本。
 */
import type { Track } from '../lib/types';

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;

/**
 * 二创署名。东方 / 蔚蓝档案二创要求标明「原曲名 + 出处作品」这两件事，写全即可。
 * 原曲的作曲者不在此列出 —— 曲目表已经够密，作者信息交给简介正文承载。
 */
const originOf = (t: Track) => {
  if (!t.original) return '';
  return t.source ? `${t.original} / ${t.source}` : t.original;
};

const creditOf = (t: Track) => t.arrange ?? t.compose ?? '';
const creditLabel = (t: Track) => (t.arrange ? '编曲' : '作曲');
---

<ol class="tracks">
  {
    tracks.map((t) => (
      <li class="tracks__row">
        <span class="tracks__no mono-num">{String(t.no).padStart(2, '0')}</span>

        <span class="tracks__main">
          <span class="tracks__head">
            <span class="tracks__title clip" title={t.title}>
              <span class="clip-inner">{t.title}</span>
            </span>
            {
              /* note 独立成标签。早先版本把它当成 origin 的替身，
                 结果「Bonus」这类标注在有原曲的曲目上会被吃掉 */
              t.note && <span class="tracks__note">{t.note}</span>
            }
          </span>
          {
            originOf(t) && (
              <span class="tracks__origin clip" title={originOf(t)}>
                <span class="clip-inner">{originOf(t)}</span>
              </span>
            )
          }
        </span>

        <span
          class="tracks__credit clip"
          title={creditOf(t) ? `${creditLabel(t)} ${creditOf(t)}` : undefined}
        >
          {creditOf(t) && (
            <span class="clip-inner">
              <span class="tracks__credit-label">{creditLabel(t)}</span>
              {creditOf(t)}
            </span>
          )}
        </span>

        <span class="tracks__vocal clip" title={t.vocal ? `vo. ${t.vocal}` : undefined}>
          {t.vocal && <span class="clip-inner">vo. {t.vocal}</span>}
        </span>

        <span class="tracks__dur mono-num">{t.duration ?? '--:--'}</span>
      </li>
    ))
  }
</ol>

<style>
  .tracks {
    border-top: 1px solid var(--line-1);
  }

  .tracks__row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) minmax(0, 132px) 74px 52px;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-4);
    /**
     * 左右内边距：悬停时那层浅灰底会撑满整行，而序号贴最左、时长贴最右，
     * 不留边距就会紧贴灰底边缘。用 padding 而非 margin —— 全局是
     * box-sizing: border-box，行的宽度与分隔线宽度都维持原样，
     * 只有内容往里收（分隔线仍与「曲目」标题的左边界对齐）。
     * 取值与 padding-block 一致，灰底四周的呼吸感才均匀。
     */
    padding-inline: var(--s-4);
    border-bottom: 1px solid var(--line-1);
    transition: background-color var(--dur-fast) var(--ease);
  }

  .tracks__row:hover {
    background: var(--paper-100);
  }

  .tracks__no {
    font-size: var(--text-sm);
    color: var(--ink-300);
  }

  /* 曲名与署名 */
  .tracks__main {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .tracks__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    min-width: 0;
  }

  /* 裁切与「悬停滚动」由 .clip 提供（见 styles/clip.css），
     这里只管这一列的排版与配色 —— 别再往这里写 overflow / white-space。 */
  .tracks__title {
    color: var(--ink-900);
    font-size: var(--text-body);
  }

  /* 原创曲 / Bonus 之类的标注。用最轻的视觉重量，不跟曲名抢注意力 */
  .tracks__note {
    flex-shrink: 0;
    font-size: var(--text-meta);
    letter-spacing: var(--ls-wide-sm);
    color: var(--ink-400);
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    padding: 1px 6px;
    line-height: 1.5;
  }

  .tracks__origin {
    font-size: var(--text-meta);
    color: var(--ink-400);
    letter-spacing: var(--ls-wide-sm);
  }

  .tracks__credit,
  .tracks__vocal {
    font-size: var(--text-sm);
    color: var(--ink-500);
  }

  /* 编曲与作曲是实质区别（关系到东方二创的署名），始终标出来，但压低对比 */
  .tracks__credit-label {
    color: var(--ink-300);
    margin-right: 5px;
  }

  .tracks__dur {
    font-size: var(--text-sm);
    color: var(--ink-400);
    text-align: right;
  }

  /* 窄屏：压成两行，署名并到曲名下方 */
  @media (max-width: 720px) {
    .tracks__row {
      grid-template-columns: 28px minmax(0, 1fr) 48px;
      gap: var(--s-3);
      padding-block: var(--s-3);
      /* 手机上横向空间紧，内边距跟着垂直档位收一档，但仍要离开灰底边缘 */
      padding-inline: var(--s-3);
    }

    /* 手机上不再截断。
       曲名和「原曲 / 出处」是这张表的主要内容，省略号会把
       「Dolce Biblioteca / 蔚蓝档案」的出处整个吃掉 ——
       而标明出处正是二创署名义务的硬要求，宁可让行高不齐也不能省。 */
    .tracks__title,
    .tracks__origin {
      white-space: normal;
      overflow: visible;
      overflow-wrap: anywhere;
    }

    /* 内层退化为普通行内文本，跟随上面的换行，不再滚动、不撑破容器。
       这一条同时让 BaseLayout 的测量脚本按 white-space 判定「无需滚动」，
       渐隐遮罩也就自动不出现了 —— 所以这里不需要再显式关遮罩。 */
    .clip-inner {
      display: inline;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .tracks__head {
      flex-wrap: wrap;
      row-gap: 4px;
    }

    .tracks__credit,
    .tracks__vocal {
      grid-column: 2 / 3;
      font-size: var(--text-meta);
      color: var(--ink-400);
    }

    .tracks__vocal:empty {
      display: none;
    }
  }
</style>
